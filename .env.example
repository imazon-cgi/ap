# Banco do ImazonGeo (imazongeo_upload). Sem esta variável — ou com o banco
# fora do ar — o dashboard lê os rankings do S3.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/imazongeo

# Visão lida pelo dashboard (padrão: imazongeo.vw_ameaca_pressao)
# AP_DB_VIEW=imazongeo.vw_ameaca_pressao
# Tempo de cache das respostas do banco, em ms (padrão: 600000 = 10 min)
# AP_DB_CACHE_MS=600000
# Simplificação das geometrias, em graus (padrão: 0.001 ≈ 100 m; 0 desliga)
# AP_DB_SIMPLIFICAR=0.001
# Casas decimais das coordenadas (padrão: 5 ≈ 1 m)
# AP_DB_DECIMAIS=5
